Set the FRISC-V CPU and UART clock to 25 MHz

diff --git a/kernel/arch/riscv/dts/friscv.dts b/kernel/arch/riscv/dts/friscv.dts
index 36f42f6..16a2a86 100644
--- a/kernel/arch/riscv/dts/friscv.dts
+++ b/kernel/arch/riscv/dts/friscv.dts
@@ -23,7 +23,7 @@
             status = "okay";
             riscv,isa = "rv32ima_zifencei_zicsr";
             mmu-type = "riscv,sv32";
-            clock-frequency = <50000000>;
+            clock-frequency = <25000000>;
 
             cpu0_intc: interrupt-controller {
                 #address-cells = <0>;
@@ -50,7 +50,7 @@
         reg = <0x10000000 0x100>;
         reg-shift = <2>;
         reg-io-width = <4>;
-        clock-frequency = <50000000>;
+        clock-frequency = <25000000>;
         current-speed = <115200>;
     };
 };
